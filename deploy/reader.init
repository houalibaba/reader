#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
BASE=/mnt/sda1/reader

start_service() {
    [ -f "$BASE/.reader-disk" ] || { logger -t reader "disk not mounted ($BASE/.reader-disk missing)"; return 1; }
    mkdir -p "$BASE/data" "$BASE/media/stories" "$BASE/media/audio" "$BASE/tmp" "$BASE/backups"
    procd_open_instance
    procd_set_param command "$BASE/reader" -config "$BASE/config.json"
    procd_set_param env GOMEMLIMIT=120MiB GOGC=50 TMPDIR="$BASE/tmp"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
